# Supabase project settings — Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (draft turn email notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Used to build links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authorizes Vercel Cron's daily call to /api/sync/games (Vercel sends
# "Authorization: Bearer $CRON_SECRET" automatically once this is set)
CRON_SECRET=
